{% comment %}
  One team-member card. Used by _layouts/profiles.liquid for both
  current members (page.profiles) and past members (page.past_profiles).
  Pass the entry as profile=...
  Fields: image (in assets/img/students/), content (in _includes/profiles/),
  email (shown last, as a mailto link), or emails: a list for several.
{% endcomment %}
{% assign profile = include.profile %}
<div class="profile-card">
  {% if profile.image %}
    {% assign profile_image_path = profile.image | prepend: 'assets/img/students/' %}
    {% assign profile_image_class = 'profile-img' %}
    {% capture sizes %}(min-width: {{site.max_width}}) 200px, 95vw{% endcapture %}
    {% include figure.liquid
      loading="lazy"
      path=profile_image_path
      class=profile_image_class
      sizes=sizes
      alt=profile.image
    %}
  {% endif %}

  <div class="profile-content">
    {% if profile.content %}
      {% include profiles/{{ profile.content }} %}
    {% endif %}

    {% if profile.email or profile.emails %}
      <div class="profile-details">
        <p><strong>Email:</strong>
          {% if profile.email %}<br><a href="mailto:{{ profile.email }}">{{ profile.email }}</a>{% endif %}
          {% for e in profile.emails %}<br><a href="mailto:{{ e }}">{{ e }}</a>{% endfor %}
        </p>
      </div>
    {% endif %}
  </div>
</div>
