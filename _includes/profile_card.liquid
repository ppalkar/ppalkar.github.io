{% comment %}
  One team-member card. Used by _layouts/profiles.liquid for both
  current members (page.profiles) and past members (page.past_profiles).
  Pass the entry as profile=...
{% endcomment %}
{% assign profile = include.profile %}
<div class="profile-card">
  {% if profile.image %}
    {% assign profile_image_path = profile.image | prepend: 'assets/img/students/' %}
    {% assign profile_image_class = 'profile-img' %}
    {% capture sizes %}(min-width: {{site.max_width}}) 200px, 95vw{% endcapture %}
    {% include figure.liquid
      loading="eager"
      path=profile_image_path
      class=profile_image_class
      sizes=sizes
      alt=profile.image
    %}
  {% endif %}

  {% if profile.more_info %}
    <div class="profile-email">{{ profile.more_info }}</div>
  {% endif %}

  <div class="profile-content">
    {% if profile.content %}
      {% include profiles/{{ profile.content }} %}
    {% endif %}
  </div>
</div>
