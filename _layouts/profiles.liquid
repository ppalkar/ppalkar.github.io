---
layout: page
---
<div class="profile-grid">
  {% for profile in page.profiles %}
    <div class="profile-card">
      {% if profile.image %}
        {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
        {% assign profile_image_class = profile.image_circular == true | default: false
          | ternary: 'profile-img rounded-circle', 'profile-img rounded' %}
        {% capture sizes %}(min-width: {{site.max_width}}) 200px, 95vw{% endcapture %}
        {% include figure.liquid 
          loading="eager" 
          path=profile_image_path 
          class=profile_image_class 
          sizes=sizes 
          alt=profile.image 
        %}
      {% endif %}

      {% if profile.more_info %}
        <div class="profile-email">{{ profile.more_info }}</div>
      {% endif %}

      <div class="profile-content">
        {% if profile.content %}
          {% capture profile_content %}
            {% include_relative _pages/{{ profile.content }} %}
          {% endcapture %}
          {{ profile_content }}
        {% else %}
          {{ content }}
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

